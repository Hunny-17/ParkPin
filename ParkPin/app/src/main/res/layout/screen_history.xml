<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/pp_bg" android:fillViewport="true" android:scrollbars="none"
    tools:context=".MainActivity" tools:ignore="HardcodedText">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="22dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LỊCH SỬ" android:letterSpacing="0.18" android:textColor="@color/pp_green" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Những nơi bạn đã đỗ" android:textColor="@color/pp_ink" android:textSize="25sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Xem lại vị trí đỗ xe đã lưu trước đây." android:textSize="13sp" android:textColor="@color/pp_ink_muted" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="21dp" android:background="@drawable/bg_tag" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="3 ĐIỂM ĐỖ MẪU" android:textColor="@color/pp_green_dark" android:textStyle="bold" android:textSize="11sp"/>
        <com.google.android.material.card.MaterialCardView style="@style/ParkPinCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="17dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_pin" app:tint="@color/pp_green" android:contentDescription="Vị trí"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="Bãi xe trung tâm" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/pp_ink"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MỚI NHẤT" android:textSize="9sp" android:textColor="@color/pp_green" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tầng B2  ·  Khu A  ·  Cột 12" android:textSize="13sp" android:textColor="@color/pp_ink_muted"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Hôm nay, 14:35  •  Gần thang máy số 2" android:textSize="11sp" android:textColor="@color/pp_ink_muted"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/ParkPinCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="17dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_pin" app:tint="@color/pp_ink_muted" android:contentDescription="Vị trí"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:text="Nhà xe khu B" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/pp_ink"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tầng trệt  ·  Dãy C  ·  Ô 08" android:textSize="13sp" android:textColor="@color/pp_ink_muted"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="08/11/2026, 09:20" android:textSize="11sp" android:textColor="@color/pp_ink_muted"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/ParkPinCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="17dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_pin" app:tint="@color/pp_ink_muted" android:contentDescription="Vị trí"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:text="Bãi xe siêu thị" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/pp_ink"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tầng B1  ·  Khu D  ·  Cột 05" android:textSize="13sp" android:textColor="@color/pp_ink_muted"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="06/11/2026, 19:10" android:textSize="11sp" android:textColor="@color/pp_ink_muted"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_tag" android:padding="14dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_info" app:tint="@color/pp_green_dark" android:contentDescription="Thông tin" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Các mục ở đây chỉ là dữ liệu giả lập để xem trước giao diện." android:textSize="12sp" android:textColor="@color/pp_green_dark"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
