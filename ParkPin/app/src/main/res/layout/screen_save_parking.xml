<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/pp_bg" android:fillViewport="true" android:scrollbars="none"
    tools:context=".MainActivity" tools:ignore="HardcodedText">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="22dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LƯU VỊ TRÍ" android:letterSpacing="0.18" android:textColor="@color/pp_green" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Xe bạn đang đỗ ở đâu?" android:textColor="@color/pp_ink" android:textSize="25sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Lưu vài chi tiết để dễ tìm lại xe sau này." android:textSize="13sp" android:textColor="@color/pp_ink_muted" />

        <com.google.android.material.card.MaterialCardView style="@style/ParkPinCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="17dp" android:gravity="center_vertical">
                <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_logo_soft">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:layout_gravity="center" android:src="@drawable/ic_location" app:tint="@color/pp_green" android:contentDescription="GPS" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="13dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tọa độ GPS hiện tại" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/pp_ink" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Chưa kết nối định vị" android:textSize="12sp" android:textColor="@color/pp_ink_muted" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SẮP CÓ" android:background="@drawable/bg_pill_gray" android:padding="8dp" android:textSize="9sp" android:textStyle="bold" android:textColor="@color/pp_ink_muted"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Thông tin bãi đỗ" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pp_ink"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:hint="Tên bãi đỗ / địa điểm" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:text="Bãi xe trung tâm"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:hint="Tầng">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:text="B2" android:inputType="textCapCharacters" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:hint="Khu vực">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A" android:inputType="textCapCharacters" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Cột / ô đỗ">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:text="12" android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Ghi chú thêm">
            <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" android:gravity="top" android:inputType="textMultiLine" android:text="Gần thang máy số 2"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Ảnh chỗ đỗ xe" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pp_ink"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="148dp" android:layout_marginTop="10dp" android:background="@drawable/bg_photo_placeholder" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_camera" app:tint="@color/pp_green" android:contentDescription="Ảnh mẫu"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Thêm ảnh bãi đỗ" android:textColor="@color/pp_ink" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Chức năng camera sẽ kết nối sau" android:textSize="11sp" android:textColor="@color/pp_ink_muted"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton style="@style/ParkPinActionButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="LƯU VỊ TRÍ" android:contentDescription="Nút lưu chưa có xử lý"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Bản UI: biểu mẫu chưa ghi dữ liệu" android:textSize="11sp" android:textColor="@color/pp_ink_muted"/>
    </LinearLayout>
</ScrollView>
