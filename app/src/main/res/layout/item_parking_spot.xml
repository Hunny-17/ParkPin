<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ParkPinCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="25dp" android:layout_height="25dp"
                android:src="@drawable/ic_pin" app:tint="@color/pp_green"
                android:contentDescription="Vị trí đã lưu"/>
            <TextView android:id="@+id/item_name" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="9dp" android:textSize="16sp"
                android:textStyle="bold" android:textColor="@color/pp_ink"/>
            <TextView android:id="@+id/item_status" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textStyle="bold" android:textColor="@color/pp_green_dark"/>
        </LinearLayout>
        <TextView android:id="@+id/item_details" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:textSize="13sp" android:textColor="@color/pp_ink_muted"/>
        <TextView android:id="@+id/item_note" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textSize="12sp" android:textColor="@color/pp_ink_muted"/>
        <TextView android:id="@+id/item_time" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textSize="11sp" android:textColor="@color/pp_ink_muted"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_edit" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="44dp"
                android:text="Sửa" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_activate" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp"
                android:minHeight="44dp" android:text="Đặt hiện tại" android:textSize="10sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_delete" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp"
                android:minHeight="44dp" android:text="Xóa" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
